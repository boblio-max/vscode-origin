{
  "version": 1,
  "comments": "Language configuration for Origin language",
  "wordPattern": "(-?\\d+\\.\\d+)|(-?\\d+)|([a-zA-Z_][a-zA-Z0-9_]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((if|elif|else|for|while|def|func|class|try|parallel|py|exec|open|match|case|with)\\b.*\\{|\\{)\\s*$",
    "decreaseIndentPattern": "^\\s*\\}\\s*$"
  },
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ]
}
